# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Phase 3 (Hevy integration) — leave blank until then
HEVY_API_KEY=
# Phase 2 (MCP auth spike) — REQUIRED to boot from Phase 2 onward.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_SECRET=
# Phase 2 — the remaining MCP_* vars have working local-dev defaults.
# They are COMMENTED OUT on purpose: an empty assignment (`MCP_ISSUER_URL=`)
# sets the value to an empty string and overrides the default, which is not
# what a blank line in this file is meant to signal.
# MCP_AUTH_MODE=static
# MCP_ISSUER_URL=https://your-project.authkit.app
# MCP_RESOURCE_URL=http://localhost:8000/mcp
# MCP_JWKS_URI=
# Host header allowlist. Matching is EXACT, with one special form: a trailing
# `:*` wildcards the port. That distinction bites locally and only locally --
# a browser or curl sends `Host: localhost:8000` when you serve on a non-default
# port, which `localhost` does NOT match, so an authenticated request returns
# `421 Invalid Host header` while an unauthenticated one still returns a
# perfectly normal-looking 401 (auth middleware runs first). Deployed, the port
# is 443 and omitted from the Host header, which is why `render.yaml` can use
# the bare `brett.onrender.com`.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
