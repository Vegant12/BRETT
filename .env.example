# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
# postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Phase 3 (Hevy integration) — leave blank until then
HEVY_API_KEY=
# Phase 2 (MCP auth spike) — REQUIRED to boot from Phase 2 onward.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_AUTH_SECRET=
# Phase 2 — the remaining MCP_* vars have working local-dev defaults.
# They are COMMENTED OUT on purpose: an empty assignment (`MCP_ISSUER_URL=`)
# sets the value to an empty string and overrides the default, which is not
# what a blank line in this file is meant to signal.
# MCP_AUTH_MODE=static
# MCP_ISSUER_URL=https://your-project.authkit.app
# MCP_RESOURCE_URL=http://localhost:8000/mcp
# MCP_JWKS_URI=
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1
